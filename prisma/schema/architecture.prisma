model Architecture {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String   @default("System Architecture")
  status      String   @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, BUILT, LEARNING
  diagram     String?  @db.Text
  content     String?  @db.Text
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
